{
  "entities": {
    "Paper": {
      "title": "Paper",
      "description": "An intelligence briefing or document submitted or published on GrayTell.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 10000 },
        "category": { "type": "string", "enum": ["counter-terrorism", "military", "crime"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorEmail": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 128 },
        "sources": { "type": "array", "description": "Array of sources with name, url, logoUrl" }
      },
      "required": ["id", "title", "content", "category", "status", "authorId", "authorEmail", "createdAt", "updatedAt", "sources"]
    }
  },
  "firestore": {
    "/papers/{paperId}": {
      "schema": "Paper",
      "description": "Collection of intelligence papers, briefings, and draft submissions."
    }
  }
}
