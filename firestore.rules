rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'sapkotaanubhav91@gmail.com';
    }

    function isOwner(resourceData) {
      return isSignedIn() && resourceData.authorId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPaper(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() >= 5 && data.title.size() <= 200
        && data.summary is string && data.summary.size() <= 1000
        && data.content is string && data.content.size() >= 10 && data.content.size() <= 10000
        && data.category is string && (data.category == 'counter-terrorism' || data.category == 'military' || data.category == 'crime')
        && data.status is string && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected')
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorEmail is string && data.authorEmail.size() <= 128
        && data.createdAt is string && data.createdAt.size() <= 128
        && data.updatedAt is string && data.updatedAt.size() <= 128
        && data.sources is list && data.sources.size() <= 100;
    }

    match /papers/{paperId} {
      // Access permissions:
      // - Approved papers are publicly readable.
      // - Pending/rejected papers are readable by their owners or administrators.
      allow get: if resource.data.status == 'approved' || isOwner(resource.data) || isAdmin();
      allow list: if resource.data.status == 'approved' || isOwner(resource.data) || isAdmin();

      // Creation:
      // - Signed-in users can create. Standard users must submit with status 'pending' and correct ownership fields.
      // - Admins can publish directly with status 'approved' or any status.
      allow create: if isSignedIn()
        && isValidId(paperId)
        && isValidPaper(request.resource.data)
        && (
          isAdmin() || (
            request.resource.data.status == 'pending'
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorEmail == request.auth.token.email
          )
        );

      // Updates:
      // - Owners can edit their own papers ONLY if the paper is still 'pending' (terminal state locks apply once approved/rejected).
      //   They must not change ownership, createdAt, or status (must stay pending).
      // - Admins can modify any field, update status, approve, reject, or edit.
      allow update: if isSignedIn()
        && isValidPaper(request.resource.data)
        && (
          isAdmin() || (
            isOwner(resource.data)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.authorEmail == resource.data.authorEmail
            && request.resource.data.createdAt == resource.data.createdAt
          )
        );

      // Deletion:
      // - Only admins can delete papers.
      allow delete: if isAdmin();
    }
  }
}
